    { "id": "tff_festival_queen", "name": "Festival Queen Aurelia", "color": "sun", "subtype": "Noble", "cost": 5, "power": 4, "health": 5, "keywords": ["shield"], "rarity": "rare", "effects": [ { "on": "attack", "op": "heal", "amount": 1 } ] },

    { "id": "tff_grave_moth", "name": "Grave Moth", "color": "moon", "subtype": "Moth", "cost": 2, "power": 2, "health": 1, "rarity": "common", "effects": [ { "on": "dies", "op": "drain", "amount": 1 } ] },
    { "id": "tff_shadow_shove", "name": "Shadow Shove", "color": "moon", "type": "spell", "cost": 1, "rarity": "common", "effects": [ { "on": "cast", "op": "push", "target": "enemy_creature" }, { "on": "cast", "op": "drain", "amount": 1 } ] },
    { "id": "tff_night_market_ghoul", "name": "Night Market Ghoul", "color": "moon", "subtype": "Ghoul", "cost": 4, "power": 3, "health": 4, "rarity": "uncommon", "effects": [ { "on": "attack", "op": "drain", "amount": 1 } ], "flavor": "Sells you a lantern. Takes your shadow as payment." },
    { "id": "tff_hollow_owl", "name": "Hollow Owl", "color": "moon", "subtype": "Owl", "cost": 3, "power": 2, "health": 3, "keywords": ["soar", "reach"], "rarity": "uncommon" },
    { "id": "tff_moonlit_masquerade", "name": "Moonlit Masquerade", "color": "moon", "type": "spell", "cost": 5, "rarity": "rare", "effects": [ { "on": "cast", "op": "destroy_all", "max_power": 3 } ], "flavor": "Everyone takes off their masks at midnight. Some don't put them back on." },

    { "id": "tff_paper_lantern_golem", "name": "Paper Lantern Golem", "subtype": "Golem", "cost": 3, "power": 3, "health": 4, "keywords": ["move"], "rarity": "common" },
    { "id": "tff_festival_float", "name": "Festival Float", "subtype": "Construct", "cost": 6, "power": 5, "health": 7, "keywords": ["move"], "rarity": "uncommon", "flavor": "It's mostly papier-mache and good intentions." },

    { "id": "tff_lantern_spirit", "name": "Tidefall Lantern Spirit", "subtype": "Spirit", "cost": 5, "power": 3, "health": 4, "keywords": ["soar", "move"], "rarity": "secret", "effects": [ { "on": "enter", "op": "draw", "amount": 1 } ], "flavor": "Released on the last night of the festival. Nobody released this one." }
