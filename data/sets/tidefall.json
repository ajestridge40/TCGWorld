    { "id": "tff_mother_willow", "name": "Mother Willow", "color": "grove", "subtype": "Treefolk", "cost": 5, "power": 3, "health": 5, "keywords": ["reach"], "rarity": "rare", "effects": [ { "on": "dies", "op": "token", "count": 1, "token": { "name": "Sapling", "subtype": "Treefolk", "power": 3, "health": 3 } } ] },

